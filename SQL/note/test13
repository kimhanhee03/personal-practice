--ROWNUM - 222page
--SubQuery: 인라인뷰/스칼라 서브쿼리
--View / Index > 시퀀스,시노님(동의의 > 테이블의 별칭)
/*
	오라클에서 지원하는 가상 컬럼 > rownum / rowid(index 사용)
					ㄴ모든 테이블에 적용
	오라클에서 순차적으로 row의 번호를 부여
	> 사용처
	      인기 순위 Top 100
	      페이징
	      게시판 > 상세보기(이전/다음)
	> 단점
	     TOP-N > 처음 ~(중간에서 자르기가 안된다)

	224page 서브쿼리
	중첩 서브쿼리 > 조건값 > where 뒤에
	   -단일행 서브쿼리 > 결과값 1개
	   -다중행 서브쿼리 > 결과값 여러개
	    
	   -다중 컬럼 서브쿼리
	select 
	from table_name
	where 컬럼 연산자(select ~)
	비교연산자: =,>,<,>=,<= 서브쿼리의 결과값 1개
	집합연산자: IN, NOT IN
	한정연산자: ANY,SOME,ALL > 결과값중에 1개 결정 > MAX,MIN
	존재연산자: EXISTS / NOT EXISTS 
	스칼라 서브쿼리 > 컬럼 대신 사용: join대체 > select 뒤에
	-select 안에 들어가는 서브쿼리
	-반드시 결과 값1개(한생,한컬럼)
	-값 1개만 가지고 오는 select
	-주로 사용: 집계함수
	인라인 뷰 > 테이블 대신 사용: 한번 사용(보안,페이지) > FROM 뒤에
	> select문장만 가능
	> 즉석 검색 결과
	스칼라 서브 쿼리/인라인 뷰 > 저장이 안됨(보안)
	|컬럼 1개            |임시 테이블

	select ~ 
	from(select~)
		 ㄴ테이블 역할 > select가 안보이게 만드는 과정: view

	> 페이징, rownum 변경(순서)
	> 없는 데이터가 있는 경우에 오류 
	select empno,ename,job,hiredate,sal
	from (select ename,job,hiredate,sal from emp)
				ㄴ포함된 컬럼만 사용이 가능

	

*/
select ename, avg(sal)
from emp
--에러
select ename.(select avg(sal) from emp) 
from emp;
--이렇게는 됨
