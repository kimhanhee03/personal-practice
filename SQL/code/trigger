commit;
/*
    insert into 입고 values(100,3,1500)
    :new
    :old 이전에 등록된 값
*/

create or replace trigger 입고_trigger
after insert on 입고
for each row 
declare
 v_cnt number;
 begin
 --상품이 재고 있는지 확인
 select count(*) into v_cnt
 from 재고
 where 품번=:new.품번; -- 입고시에 insert로 들어오는 값
 if v_cnt=0 then
 insert into 재고 values(:new.품번,:new.수량,:new.금액,:new.수량*:new.금액);
 else
    update 재고 set
    수량=수량+:new.수량,
    누적금액=누적금액+(:new.수량*:new.금액)
    where 품번=:new.품번;
    --commit사용하면 오류
 end if;
 end;
 /
